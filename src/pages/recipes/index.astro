---
import Base from '../../layouts/Base.astro';import RecipeCard from '../../components/RecipeCard.astro';import {getCollection} from 'astro:content';const recipes=(await getCollection('recipes')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());const categories=[...new Set(recipes.map(r=>r.data.category))];
---
<Base title="Recipes | NewFavorite" description="Find your next favorite recipe, from familiar favorites to unexpected discoveries."><div class="wrap listing"><p class="eyebrow">THE RECIPE COLLECTION</p><h1>Recipes</h1><p class="lede">A mix of familiar favorites and something new.</p><div class="filters"><input id="search" type="search" placeholder="Search recipes or ingredients…" aria-label="Search recipes"/><select id="category" aria-label="Filter by category"><option value="">All categories</option>{categories.map(c=><option value={c}>{c}</option>)}</select><select id="difficulty" aria-label="Filter by difficulty"><option value="">All difficulties</option><option>Easy</option><option>Intermediate</option><option>Advanced</option></select></div><div class="card-grid" id="results">{recipes.map(r=><div class="filter-card" data-search={[r.data.title,r.data.description,...r.data.ingredients.map(i=>i.name),...r.data.tags].join(' ').toLowerCase()} data-category={r.data.category} data-difficulty={r.data.difficulty}><RecipeCard recipe={r}/></div>)}</div><p id="empty" hidden>No recipes match those filters.</p></div><script>const search=document.querySelector<HTMLInputElement>('#search')!,category=document.querySelector<HTMLSelectElement>('#category')!,difficulty=document.querySelector<HTMLSelectElement>('#difficulty')!;function filter(){let shown=0;document.querySelectorAll<HTMLElement>('.filter-card').forEach(el=>{const ok=(el.dataset.search||'').includes(search.value.toLowerCase().trim())&&(!category.value||el.dataset.category===category.value)&&(!difficulty.value||el.dataset.difficulty===difficulty.value);el.hidden=!ok;if(ok)shown++});document.querySelector<HTMLElement>('#empty')!.hidden=shown>0}for(const el of [search,category,difficulty])el.addEventListener('input',filter)</script></Base>

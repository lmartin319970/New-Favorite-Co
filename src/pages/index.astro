---
import Base from '../layouts/Base.astro';import Newsletter from '../components/Newsletter.astro';import RecipeCard from '../components/RecipeCard.astro';import {getCollection} from 'astro:content';
const recipes=(await getCollection('recipes')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());const discover=[...(await getCollection('discover')).map(entry=>({entry,href:`/discover/${entry.id}/`})),...(await getCollection('journal')).map(entry=>({entry,href:`/journal/${entry.id}/`}))].sort((a,b)=>b.entry.data.date.valueOf()-a.entry.data.date.valueOf());
---
<Base><section class="hero"><img class="hero-photo" src="/images/hero.png" alt="A table of colorful home-cooked food" fetchpriority="high"/><div class="hero-shade"></div><div class="wrap hero-content"><p class="eyebrow">FOOD & COOKING</p><h1>Find your next<br/>favorite.</h1><p>Explore tested recipes, ingredient guides, and practical cooking techniques.</p><a class="btn" href="/recipes/">Browse recipes <span aria-hidden="true">↗</span></a></div></section>
<div class="wrap page-sections">
<section class="home-recipes"><div class="section-head"><div><p class="eyebrow">FROM THE KITCHEN</p><h2>Featured recipes</h2></div><a class="text-link" href="/recipes/">All recipes <span aria-hidden="true">↗</span></a></div><div class="featured-recipes">{recipes.slice(0,2).map((recipe,index)=><a class="feature-recipe" href={`/recipes/${recipe.id}/`}><img src={recipe.data.image||'/images/hero.png'} alt={recipe.data.imageAlt||recipe.data.title} loading="lazy" decoding="async"/><div class="feature-recipe-copy"><p class="eyebrow">{index===0?'IN FOCUS':'ALSO WORTH A TRY'} · {recipe.data.category}</p><h3>{recipe.data.title}</h3><p>{recipe.data.description}</p></div></a>)}</div><div class="home-recent"><div class="recent-recipes-head"><h3>Recent recipes</h3><a class="text-link" href="/recipes/">View all <span aria-hidden="true">↗</span></a></div><div class="card-grid home-recent-grid">{recipes.slice(0,3).map(recipe=><RecipeCard recipe={recipe}/>)}</div></div><div class="surprise-strip" role="group" aria-label="Recipe suggestion"><span class="eyebrow">NEED AN IDEA?</span><span class="surprise-copy">Get a recipe suggestion</span><button class="surprise-button" id="surprise">Surprise me <span aria-hidden="true">↗</span></button></div></section>
<section><div class="section-head"><div><p class="eyebrow">INGREDIENTS, TECHNIQUES & STORIES</p><h2>Discover</h2></div><a class="text-link" href="/discover/">All Discover articles <span aria-hidden="true">↗</span></a></div><div class="editorial-grid">{discover.slice(0,2).map(({entry,href})=><a class="editorial-card" href={href}><img src={entry.data.image||'/images/hero.png'} alt={entry.data.imageAlt||entry.data.title} loading="lazy" decoding="async"/><div><p class="eyebrow">DISCOVER · {entry.data.date.toLocaleDateString('en-US',{month:'long',year:'numeric'})}</p><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div></a>)}</div></section>
<Newsletter/></div><script define:vars={{urls:recipes.map(x=>`/recipes/${x.id}/`)}}>document.getElementById('surprise')?.addEventListener('click',()=>{if(urls.length)location.href=urls[Math.floor(Math.random()*urls.length)]})</script></Base>

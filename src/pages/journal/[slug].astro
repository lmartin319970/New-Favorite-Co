---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('journal')).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.title} | NewFavorite`} description={d.description} image={d.image || '/images/hero.png'} type="article">
  <article class="wrap article journal-entry">
    <a class="back-link" href="/discover/">← Journal</a>
    <p class="eyebrow">JOURNAL</p>
    <h1>{d.title}</h1>
    <p class="lede">{d.description}</p>
    <div class="prose"><Content /></div>
    <img class="article-hero" src={d.image || '/images/hero.png'} alt={d.imageAlt || d.title} fetchpriority="high" />
  </article>
</Base>

---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';const items=[...(await getCollection('discover')).map(entry=>({entry,href:`/discover/${entry.id}/`})),...(await getCollection('journal')).map(entry=>({entry,href:`/journal/${entry.id}/`}))].sort((a,b)=>b.entry.data.date.valueOf()-a.entry.data.date.valueOf());
---
<Base title="Journal | NewFavorite"><div class="wrap listing"><p class="eyebrow">INGREDIENTS & TECHNIQUES</p><h1>Journal</h1><p class="lede">Ingredient guides, cooking techniques, and stories from the kitchen.</p><div class="editorial-grid">{items.map(({entry,href})=><a class="editorial-card" href={href}><img src={entry.data.image||'/images/hero.png'} alt={entry.data.imageAlt||entry.data.title} loading="lazy" decoding="async"/><div><p class="eyebrow">JOURNAL · {entry.data.date.toLocaleDateString('en-US',{month:'long',year:'numeric'})}</p><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div></a>)}</div></div></Base>
